{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "brass-pittsburgh-metrics",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-17",
  "workers_dev": true,
  "vars": {
    "ALLOWED_ORIGIN": "https://sirhero8282.github.io"
  },
  "durable_objects": {
    "bindings": [{ "name": "METRICS", "class_name": "SiteMetrics" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SiteMetrics"] }]
}
